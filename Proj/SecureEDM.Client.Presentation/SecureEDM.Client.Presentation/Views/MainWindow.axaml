<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SecureEDM.Client.Presentation.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:SecureEDM.Client.Presentation.Views"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="840"
        x:Class="SecureEDM.Client.Presentation.Views.MainWindow"
        Icon="/Assets/avalonia-logo.ico"
        Width="1440" Height="900"
        MinWidth="1000" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        FontFamily="Inter"
        Title="Электронный документооборот — SecureEDM">
        <views:MainView />
</Window>
