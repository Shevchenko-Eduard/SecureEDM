<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SecureEDM.Client.Presentation.ViewModels"
             xmlns:controls="using:SecureEDM.Client.Presentation.Controls"
             mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="800"
             x:Class="SecureEDM.Client.Presentation.Views.VerificationView"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="False">

    <Grid Margin="36,36,44,64" MaxWidth="1180" HorizontalAlignment="Stretch">
        <Grid ColumnDefinitions="5*,22,7*">
            <Border Grid.Column="0" Classes="panel">
                <StackPanel>
                    <TextBlock Classes="h2" Text="Проверить подпись из реестра" />

                    <TextBlock Classes="field-label" Text="Документ" />
                    <ComboBox ItemsSource="{Binding VerifyDocuments}"
                              SelectedItem="{Binding SelectedVerifyDocument}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Classes="field-label" Text="Подпись" Margin="0,16,0,6" />
                    <ComboBox ItemsSource="{Binding VerifySignatures}"
                              SelectedItem="{Binding SelectedVerifySignature}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,22,0,0">
                        <Button Classes="primary" Content="Проверить"
                                Command="{Binding VerifySignatureCommand}" />
                    </StackPanel>

                    <TextBlock Classes="h3" Text="Проверить пакет подписи" />
                    <Border x:Name="DropZone" Classes="drop" DragDrop.AllowDrop="True" Cursor="Hand">
                        <TextBlock Text="Перетащите .json-пакет сюда или нажмите для выбора файла"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{DynamicResource MuteBrush}" FontSize="14" />
                    </Border>

                    <TextBlock Classes="note" Margin="0,16,0,0"
                               Text="Пакет содержит документ, подпись, открытый ключ и метаданные; проверяется независимо от реестра." />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Classes="panel">
                <StackPanel>
                    <TextBlock Classes="h2" Text="Результат проверки" />

                    <TextBlock Classes="empty" IsVisible="{Binding IsVerifyEmptyVisible}"
                               Text="{Binding VerifyEmptyText}" />

                    <Border IsVisible="{Binding IsVerifyResultVisible}"
                            Classes="cert"
                            Classes.ok="{Binding IsVerifyOk}"
                            Classes.bad="{Binding !IsVerifyOk}"
                            CornerRadius="14" Padding="20">
                        <Grid ColumnDefinitions="140,20,*">
                            <controls:SealControl Grid.Column="0" Width="140" Height="140"
                                                  IsValid="{Binding IsVerifyOk}"
                                                  RingText="{Binding VerifySealRingText}"
                                                  CenterText="{Binding VerifySealCenterText}"
                                                  CenterFontSize="17"
                                                  ValidBrush="{DynamicResource OkBrush}"
                                                  InvalidBrush="{DynamicResource BadBrush}"
                                                  RenderTransform="rotate(-4deg)" />

                            <Grid Grid.Column="2" ColumnDefinitions="120,*"
                                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                  VerticalAlignment="Center">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Итог" TextWrapping="Wrap"
                                           Foreground="{DynamicResource MuteBrush}" FontSize="14"
                                           Margin="0,0,0,10" />
                                <Border Grid.Row="0" Grid.Column="1" Classes="status"
                                        HorizontalAlignment="Left" Margin="0,0,0,10"
                                        Classes.ok="{Binding IsVerifyOk}"
                                        Classes.bad="{Binding !IsVerifyOk}">
                                    <TextBlock Text="{Binding VerifyVerdictText}" />
                                </Border>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Авторство" TextWrapping="Wrap"
                                           Foreground="{DynamicResource MuteBrush}" FontSize="14"
                                           Margin="0,0,0,10" />
                                <Border Grid.Row="1" Grid.Column="1" Classes="status"
                                        HorizontalAlignment="Left" Margin="0,0,0,10"
                                        Classes.ok="{Binding VerifyAuthorshipOk}"
                                        Classes.bad="{Binding VerifyAuthorshipBad}">
                                    <TextBlock Text="{Binding VerifyAuthorshipText}" TextWrapping="Wrap" />
                                </Border>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Целостность" TextWrapping="Wrap"
                                           Foreground="{DynamicResource MuteBrush}" FontSize="14"
                                           Margin="0,0,0,10" />
                                <Border Grid.Row="2" Grid.Column="1" Classes="status"
                                        HorizontalAlignment="Left" Margin="0,0,0,10"
                                        Classes.ok="{Binding VerifyIntegrityOk}"
                                        Classes.bad="{Binding VerifyIntegrityBad}">
                                    <TextBlock Text="{Binding VerifyIntegrityText}" TextWrapping="Wrap" />
                                </Border>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Ключ" TextWrapping="Wrap"
                                           Foreground="{DynamicResource MuteBrush}" FontSize="14"
                                           Margin="0,0,0,10" />
                                <Border Grid.Row="3" Grid.Column="1" Classes="status"
                                        HorizontalAlignment="Left" Margin="0,0,0,10"
                                        Classes.ok="{Binding VerifyKeyOk}"
                                        Classes.bad="{Binding VerifyKeyBad}">
                                    <TextBlock Text="{Binding VerifyKeyText}" />
                                </Border>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Подписант" TextWrapping="Wrap"
                                           Foreground="{DynamicResource MuteBrush}" FontSize="14"
                                           Margin="0,0,0,10" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding VerifySignerText}"
                                           FontSize="15" Margin="0,0,0,10" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Время" TextWrapping="Wrap"
                                           Foreground="{DynamicResource MuteBrush}" FontSize="14"
                                           Margin="0,0,0,10" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding VerifyTimeText}"
                                           FontSize="15" Margin="0,0,0,10" />

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Хеш при подписании" TextWrapping="Wrap"
                                           Foreground="{DynamicResource MuteBrush}" FontSize="14" />
                                <TextBlock Grid.Row="6" Grid.Column="1" Classes="mono"
                                           Text="{Binding VerifyHashText}" />
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
