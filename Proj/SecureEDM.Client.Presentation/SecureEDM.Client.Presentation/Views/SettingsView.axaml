<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SecureEDM.Client.Presentation.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="800"
             x:Class="SecureEDM.Client.Presentation.Views.SettingsView"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="False">

    <Grid Margin="36,36,44,64" MaxWidth="1180" HorizontalAlignment="Stretch">
        <Border Classes="panel" MaxWidth="760" HorizontalAlignment="Stretch">
            <StackPanel>
                <TextBlock Classes="h2" Text="Настройки клиента" />

                <TextBlock Classes="field-label" Text="AuthServer API" />
                <TextBox Text="{Binding SettingsAuthApiUrl}"
                         PlaceholderText="https://localhost:7001"
                         IsEnabled="{Binding CanManageSettings}" />

                <TextBlock Classes="field-label" Text="BridgeServer API" Margin="0,16,0,6" />
                <TextBox Text="{Binding SettingsBridgeApiUrl}"
                         PlaceholderText="https://localhost:7002"
                         IsEnabled="{Binding CanManageSettings}" />

                <TextBlock Classes="field-label" Text="Корневой каталог документов" Margin="0,16,0,6" />
                <TextBox Text="{Binding SettingsRootPath}"
                         IsEnabled="{Binding CanManageSettings}" />

                <TextBlock Classes="field-label" Text="Стратегия разрешения конфликтов" Margin="0,16,0,6" />
                <ComboBox ItemsSource="{Binding ConflictStrategies}"
                          SelectedItem="{Binding SelectedConflictStrategy}"
                          IsEnabled="{Binding CanManageSettings}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Classes="field-label" Text="Интервал синхронизации, минут" Margin="0,16,0,6" />
                <TextBox Text="{Binding SettingsSyncIntervalMinutes}"
                         IsEnabled="{Binding CanManageSettings}" />
                <TextBlock Classes="note" Text="{Binding SettingsSyncIntervalHint}" Margin="0,4,0,0" />

                <TextBlock Classes="error" Text="{Binding SettingsError}"
                           IsVisible="{Binding HasSettingsError}" Margin="0,12,0,0" />

                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,22,0,0">
                    <Button Classes="primary" Content="Сохранить настройки"
                            Command="{Binding SaveSettingsCommand}"
                            IsEnabled="{Binding CanSaveSettings}" />
                </StackPanel>

                <TextBlock Classes="note" Margin="0,16,0,0"
                           Text="Настройки сохраняются в локальном реестре клиента. Изменять их могут автор и администратор; проверяющему доступен просмотр." />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
